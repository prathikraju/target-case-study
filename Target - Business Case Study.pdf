/S /H4
/T (WITH   test1 AS    \(     SELECT        c.customer_state AS State,       EXTRACT\(Month FROM order_purchase_timestamp\) AS Month,       COUNT\(DISTINCT order_id\) AS No_of_orders     FROM        Target_Ecommerce.orders o     JOIN        Target_Ecommerce.customers c ON o.customer_id = c.customer_id     GROUP BY        State,Month  \))
/E (WITH   test1 AS    \(     SELECT        c.customer_state AS State,       EXTRACT\(Month FROM order_purchase_timestamp\) AS Month,       COUNT\(DISTINCT order_id\) AS No_of_orders     FROM        Target_Ecommerce.orders o     JOIN        Target_Ecommerce.customers c ON o.customer_id = c.customer_id     GROUP BY        State,Month  \))
/Pg 16 0 R
/K [10]
>>
endobj
