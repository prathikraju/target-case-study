/T (WITH test1 AS \( SELECT   EXTRACT\(YEAR FROM order_purchase_timestamp\) AS Year,   EXTRACT\(Month FROM order_purchase_timestamp\) AS Month,   ROUND\(SUM\(payment_value\), 2\) AS Current_Month_Cost_of_orders FROM    Target_Ecommerce.orders o JOIN    Target_Ecommerce.payments p ON o.order_id = p.order_id)
/E (WITH test1 AS \( SELECT   EXTRACT\(YEAR FROM order_purchase_timestamp\) AS Year,   EXTRACT\(Month FROM order_purchase_timestamp\) AS Month,   ROUND\(SUM\(payment_value\), 2\) AS Current_Month_Cost_of_orders FROM    Target_Ecommerce.orders o JOIN    Target_Ecommerce.payments p ON o.order_id = p.order_id)
