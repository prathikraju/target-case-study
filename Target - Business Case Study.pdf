/Type /StructElem
/S /H3
/T (GROUP BY    Year, Month \), test2 AS  \(SELECT    *,   LAG\(Current_Month_Cost_of_orders, 1\) OVER\(ORDER BY Year, Month \) AS Previous_Month_Cost_of_orders FROM    test1 \) SELECT    *,   ROUND\(\(\(Current_Month_Cost_of_orders - Previous_Month_Cost_of_orders\) / Previous_Month_Cost_of_orders\) * 100 , 2\) AS Monthly_Percentage_Change FROM    test2 WHERE   Year IN \(2017,2018\) AND   Month Between 1 and 8 ORDER BY   Year DESC, Month DESC;)
/E (GROUP BY    Year, Month \), test2 AS  \(SELECT    *,   LAG\(Current_Month_Cost_of_orders, 1\) OVER\(ORDER BY Year, Month \) AS Previous_Month_Cost_of_orders FROM    test1 \) SELECT    *,   ROUND\(\(\(Current_Month_Cost_of_orders - Previous_Month_Cost_of_orders\) / Previous_Month_Cost_of_orders\) * 100 , 2\) AS Monthly_Percentage_Change FROM    test2 WHERE   Year IN \(2017,2018\) AND   Month Between 1 and 8 ORDER BY   Year DESC, Month DESC;)
/Pg 17 0 R
/K [1]
>>
