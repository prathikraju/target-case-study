/T (WITH  test1 AS \( SELECT    customer_state AS State,   CEILING\(AVG\(DATE_DIFF\(order_delivered_customer_date , order_purchase_timestamp , DAY\)\)\) AS Avg_Delivery_Time,   CEILING\(AVG\(DATE_DIFF\(order_estimated_delivery_date , order_purchase_timestamp , DAY\)\)\) AS Avg_Estimated_Delivery_Time FROM   Target_Ecommerce.orders o1 JOIN   Target_Ecommerce.customers c ON o1.customer_id = c.customer_id GROUP BY    State ORDER BY    State  \))
/E (WITH  test1 AS \( SELECT    customer_state AS State,   CEILING\(AVG\(DATE_DIFF\(order_delivered_customer_date , order_purchase_timestamp , DAY\)\)\) AS Avg_Delivery_Time,   CEILING\(AVG\(DATE_DIFF\(order_estimated_delivery_date , order_purchase_timestamp , DAY\)\)\) AS Avg_Estimated_Delivery_Time FROM   Target_Ecommerce.orders o1 JOIN   Target_Ecommerce.customers c ON o1.customer_id = c.customer_id GROUP BY    State ORDER BY    State  \))
/Pg 20 0 R
/K [1]
>>
