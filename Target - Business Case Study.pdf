/E (WITH test1 AS \( SELECT EXTRACT\(YEAR FROM order_purchase_timestamp\) AS Year, EXTRACT\(Month FROM order_purchase_timestamp\) AS Month, COUNT\(DISTINCT order_id\) AS Current_Month_orders FROM Target_Ecommerce.orders o LEFT JOIN Target_Ecommerce.customers c ON o.customer_id = c.customer_id LEFT JOIN)
