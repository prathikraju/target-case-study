/Type /StructElem
/S /H4
/T (Target_Ecommerce.geolocation g ON c.customer_zip_code_prefix = g.geolocation_zip_code_prefix GROUP BY Year,Month \) SELECT *, ROUND\(\(\(Current_Month_orders-Previous_Month_orders\) / Previous_Month_orders\) * 100, 2\) AS Percentage_Change FROM \( SELECT Year, Month, Lead\(Current_Month_orders\) OVER\(ORDER BY Year DESC, Month DESC\) AS Previous_Month_orders, Current_Month_orders FROM test1 \) t Order by Year, Month;)
/E (Target_Ecommerce.geolocation g ON c.customer_zip_code_prefix = g.geolocation_zip_code_prefix GROUP BY Year,Month \) SELECT *, ROUND\(\(\(Current_Month_orders-Previous_Month_orders\) / Previous_Month_orders\) * 100, 2\) AS Percentage_Change FROM \( SELECT Year, Month, Lead\(Current_Month_orders\) OVER\(ORDER BY Year DESC, Month DESC\) AS Previous_Month_orders, Current_Month_orders FROM test1 \) t Order by Year, Month;)
/Pg 13 0 R
/K [5]
>>
