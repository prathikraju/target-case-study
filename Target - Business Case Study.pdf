/E (SELECT   *,   CEILING\(\(Avg_Estimated_Delivery_Time - Avg_Delivery_Time\)\) AS Diff_Estimated_Delivery_Time FROM    test1 ORDER BY    Diff_Estimated_Delivery_Time DESC LIMIT 5;)
/Pg 20 0 R
/K [2]
>>
